{
  "schemaVersion": 1,
  "workflow": {
    "skill": "publish-mod-update",
    "revision": 5
  },
  "modName": "The Vault Render Optimization",
  "releaseLedger": "docs/release-ledger.json",
  "version": {
    "sourceFiles": [
      "gradle.properties"
    ],
    "property": "mod_version",
    "tagPrefix": "v"
  },
  "build": {
    "testCommand": ".\\gradlew.bat test",
    "compatibilityCommand": ".\\scripts\\build-pack-compatibility.ps1",
    "buildCommand": ".\\gradlew.bat clean build",
    "artifactGlob": "build/libs/vault_render_optimization.*.jar",
    "excludeGlobs": [
      "*-sources.jar",
      "*-dev.jar",
      "*-shadow.jar"
    ]
  },
  "github": {
    "repository": "HoYin1600p/The-Vault-Render-Optimization",
    "defaultBranch": "main",
    "description": "Client-side Forge 1.18.2 performance for Vault Hunters: faster Create rendering, particles, chunks, models, and Sophisticated Storage displays.",
    "versionTrackingJson": "update.json",
    "versionTrackingProductionUrl": "https://raw.githubusercontent.com/HoYin1600p/The-Vault-Render-Optimization/main/update.json",
    "versionTrackingPointers": {
      "version": "/promos/1.18.2-latest",
      "recommendedVersion": "/promos/1.18.2-recommended",
      "messageTemplate": "/1.18.2/{version}",
      "criticalEncoding": "message-prefix",
      "criticalPrefix": "[CRITICAL] ",
      "normalPrefix": "",
      "removeMessageWhenNull": false
    }
  },
  "curseforge": {
    "projectId": "1637635",
    "projectSlug": "vault-render-optimization",
    "uploadCommand": ".\\scripts\\publish-curseforge.ps1 -Version <version> -ChangelogFile <path> -GitHubReleaseUrl <url>",
    "uploadDryRunCommand": ".\\scripts\\publish-curseforge.ps1 -Version 0.4.2 -ChangelogFile docs/curseforge/CHANGELOG-0.4.2.md -GitHubReleaseUrl https://github.com/HoYin1600p/The-Vault-Render-Optimization/releases/tag/v0.4.2 -DryRun",
    "uploadTokenEnvironment": "CURSEFORGE_API_TOKEN",
    "descriptionFile": "docs/curseforge/DESCRIPTION.md",
    "descriptionFormat": "markdown",
    "releaseChannel": "release",
    "gameVersionIds": [
      9008,
      7498,
      9638,
      8326
    ],
    "gameVersionTypes": [
      {"name": "Minecraft", "id": "73250"},
      {"name": "Modloader", "id": "68441"},
      {"name": "Environment", "id": "75208"},
      {"name": "Java", "id": "2"}
    ],
    "gameVersions": [
      "1.18.2",
      "Forge",
      "Client"
    ],
    "approvalPollMinutes": 15,
    "manualRelease": false
  },
  "compatibility": {
    "gameVersionSources": [
      "gradle.properties"
    ],
    "loaderSources": [
      "src/main/resources/META-INF/mods.toml"
    ],
    "minecraft": "1.18.2",
    "forge": "40.3.11 or newer in the Forge 40.x line",
    "java": 17,
    "environment": "client"
  },
  "identity": {
    "scanCommand": ".\\scripts\\verify-public-identity.ps1",
    "scanLog": {
      "location": "external-codex-shadow-workspace",
      "relativePath": "identity-scan/identity-scan-log.md",
      "workspaceGitConfig": "codex.shadowWorkspace"
    }
  },
  "automation": {
    "approvalMonitor": {
      "enabled": true,
      "workflowFile": ".github/workflows/curseforge-approval-monitor.yml",
      "command": ".\\scripts\\curseforge-approval-monitor.ps1",
      "selfTestCommand": ".\\scripts\\curseforge-approval-monitor.ps1 -SelfTest",
      "verificationMode": "public-file-page",
      "publicFileUrlTemplate": "https://www.curseforge.com/minecraft/mc-mods/{projectSlug}/files/{fileId}",
      "scheduleMinutes": 15,
      "attentionAfterHours": 72,
      "activationMode": "direct-push"
    }
  }
}
