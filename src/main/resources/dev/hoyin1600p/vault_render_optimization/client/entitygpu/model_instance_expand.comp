        precise float ty = (n10 * nx + n11 * ny) + n12 * nz;
        precise float tz = (n20 * nx + n21 * ny) + n22 * nz;
        // GeckoLib flat cubes (IGeoRenderer.renderCube): a negative component is negated; exact.
        if ((flags & 2u) != 0u && tx < 0.0) tx = -tx;
        if ((flags & 4u) != 0u && ty < 0.0) ty = -ty;
        if ((flags & 8u) != 0u && tz < 0.0) tz = -tz;

        uint o = outBase + v * VERTEX_WORDS;
        vertices[o] = floatBitsToUint(px);
        vertices[o + 1u] = floatBitsToUint(py);
        vertices[o + 2u] = floatBitsToUint(pz);
        vertices[o + 3u] = color;
        precise float mu = suSpan * mesh[d + 3u];
        precise float mv = svSpan * mesh[d + 4u];
        precise float ru = su0 + mu;
        precise float rv = sv0 + mv;
        vertices[o + 4u] = floatBitsToUint(remap ? ru : mesh[d + 3u]);
        vertices[o + 5u] = floatBitsToUint(remap ? rv : mesh[d + 4u]);
        vertices[o + 6u] = overlay;
        vertices[o + 7u] = light;
        vertices[o + 8u] = normalByte(tx) | (normalByte(ty) << 8) | (normalByte(tz) << 16);
    }
#endif
#endif
